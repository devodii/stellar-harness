FROM node:22-slim

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA} \
    HARNESS_DATA_DIR=/app/data \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN corepack enable
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages ./packages
COPY apps/scan-cli ./apps/scan-cli
RUN pnpm install --frozen-lockfile --filter scan-cli...

CMD ["pnpm", "scan", "all"]
