{
  "name": "stellar-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r test",
    "scan": "pnpm --filter scan-cli scan",
    "report": "pnpm --filter scan-cli scan report",
    "refresh:public": "tsx scripts/refresh-public-data.ts",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.15.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@harness/schema": "workspace:*",
    "@harness/storage": "workspace:*"
  }
}
