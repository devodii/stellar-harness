# The scanner loads the repository root .env at runtime. Every value is optional.

# Enables Census 5 (GitHub issues); without it the census is skipped.
GITHUB_TOKEN=

# Where scan output is written, relative to the repository root.
HARNESS_DATA_DIR=./data

# Failed transaction window for Census 2 (s, m, h or d suffix). --window overrides it.
FAILURE_WINDOW=7d

# Recorded in the snapshot; defaults to `git rev-parse HEAD`.
GIT_SHA=

HORIZON_URL=https://horizon.stellar.org
RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_EXPERT_URL=https://api.stellar.expert/explorer/public
STELLARLIGHT_URL=https://stellarlight.xyz

# Per-host request concurrency. --concurrency host=N overrides a single host.
CONCURRENCY_HORIZON=8
CONCURRENCY_RPC=8
CONCURRENCY_EXPERT=4
CONCURRENCY_STELLARLIGHT=4
CONCURRENCY_ANCHOR=2
